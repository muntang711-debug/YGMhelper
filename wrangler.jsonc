{
  "name": "ygmhelper",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": ["NEIS_API_KEY"]
  }
}
