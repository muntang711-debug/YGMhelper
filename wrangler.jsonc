{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ygmhelper",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ygmhelper-meal-ratings",
      "database_id": "55933f3b-ba4a-4589-a8ca-c31fc94273d4",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {"name": "RATING_IP_LIMITER", "namespace_id": "2771001", "simple": {"limit": 120, "period": 60}},
    {"name": "RATING_VOTER_LIMITER", "namespace_id": "2771002", "simple": {"limit": 5, "period": 60}}
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {"enabled": true, "invocation_logs": true}
  }
}
